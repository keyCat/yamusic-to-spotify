{
  "name": "yamusic-to-spotify",
  "productName": "YMusicToSpotify",
  "version": "1.0.0",
  "description": "Перенос плейлистов из Яндекс Музыки в Spotify",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 127.0.0.1",
    "setup": "node scripts/start.mjs --setup-only",
    "start": "node scripts/start.mjs",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "icons:generate": "node scripts/generate-icons.mjs",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "desktop:build": "node scripts/build-desktop.mjs && npm run desktop:compile && node scripts/stage-desktop.mjs",
    "desktop:dev": "npm run desktop:build && node scripts/start-desktop.mjs",
    "desktop:package": "electron-builder --config electron-builder.yml --publish never",
    "desktop:smoke": "node scripts/smoke-desktop.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "zod": "^4.5.4"
  },
  "overrides": {
    "@dxup/nuxt": "0.5.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "24.19.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "node-gyp": "^13.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}

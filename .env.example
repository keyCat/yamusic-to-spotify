# The local setup command generates a unique key in .env.
NUXT_ENCRYPTION_KEY=

# Add these values after you create the Spotify application.
NUXT_SPOTIFY_CLIENT_ID=
NUXT_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback
NUXT_SPOTIFY_MARKET=SG
NUXT_ALLOWED_SPOTIFY_USERS=

# Store the SQLite database in this directory.
NUXT_DATA_DIR=./data
